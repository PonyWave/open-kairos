NODE_ENV=development
KAIROS_HOST=127.0.0.1
# 主环境：运行 Server 的本机执行环境，内置注册、不可删除，模型侧别名为 main。
# env_id 默认为 main；工作目录默认为启动命令所在目录，覆盖时使用绝对路径。
# KAIROS_MAIN_ENV_ID=main
# KAIROS_MAIN_WORKSPACE=/absolute/path/to/workspace
KAIROS_PORT=4317
# 默认为仓库 data/server/；覆盖时使用不存在或为空的绝对路径。
# 正常启动拒绝旧 schema，不自动迁移或删除；保留数据的升级须停止 Server 后按 docs/operations.md 执行显式迁移。
# KAIROS_DATA_DIR=/absolute/path/to/new-empty-kairos-server
# 认证密钥至少 32 个字符；同时按独立用途派生个人模型凭据加密密钥。启动前必须替换，备份恢复须保留。
KAIROS_AUTH_SECRET=replace-with-at-least-32-character-random-secret
# 非 production 且 KAIROS_HOST 为 127.0.0.1、::1 或 localhost 时，可使用固定测试账号。
# 测试邮箱 test@kairos.com，固定验证码 945945；其他邮箱仍须受邀并通过 SMTP 接收验证码。
# 将邀请范围单独设为 * 时，任何格式有效的邮箱都可通过 SMTP 验证码注册和登录。
# * 与普通邮箱混用、空项及其他通配形式均拒绝启动。
# production 必须配置邀请名单或 *、HTTPS 公开 Origin 和 SMTP，测试账号不可用。
# KAIROS_AUTH_INVITED_EMAILS=invited-one@example.com,invited-two@example.com
# k1 新 release 开放全部邮箱时使用以下配置，仍须配置 SMTP、HTTPS Origin 和认证密钥。
# KAIROS_AUTH_INVITED_EMAILS=*
# KAIROS_PUBLIC_ORIGIN=https://kairos.example.com
# 受信反向代理列表；未设置时使用直连对端地址并忽略 X-Forwarded-For。
# 仅接受逗号分隔的单个 IPv4/IPv6 地址或 CIDR，禁止 true、通配符、主机名、空列表项和 /0。
# k1 的 Chamber→Caddy→Fastify 链路必须按实测配置实际代理地址；以下仅为回环示例。
# KAIROS_TRUSTED_PROXIES=127.0.0.1,::1
# KAIROS_SMTP_URL=smtps://smtp-user:replace-with-smtp-password@smtp.example.com:465
# KAIROS_SMTP_FROM=kairos-login@example.com
# 目录包含固定版本安装包及各平台的 release 清单，由 Server 提供下载与安装命令。
# KAIROS_DAEMON_RELEASE_DIR=/absolute/path/to/Kairos/dist/releases
KAIROS_MAX_RPC_BYTES=1048576
KAIROS_MAX_EVENT_QUEUE=256
KAIROS_MAX_ACTIVE_THREADS=2
KAIROS_MAX_CONCURRENT_MODEL_REQUESTS=4
KAIROS_MAX_STEPS_PER_RUN=30
KAIROS_RECAP_PERIODIC_MESSAGE_THRESHOLD=20
KAIROS_RECAP_PERIODIC_RESPONSE_WINDOW_MS=600000
KAIROS_RECALL_SQL_TIMEOUT_MS=2000
KAIROS_RECALL_SQL_MAX_ROWS=200
KAIROS_RECALL_SQL_MAX_CELL_CHARACTERS=16384
KAIROS_RECALL_SQL_MAX_RESPONSE_BYTES=262144
# 授权副本的计量字节上限。
KAIROS_RECALL_SQL_MAX_SNAPSHOT_BYTES=33554432
# 仅限制子进程的 V8 JavaScript 旧生代堆，不表示整个进程或 SQLite 原生内存上限。
KAIROS_RECALL_SQL_MAX_JAVASCRIPT_HEAP_MB=128
# SQLite hard_heap_limit 原生内存上限与单个 SQLite 值长度上限。
KAIROS_RECALL_SQL_MAX_SQLITE_MEMORY_BYTES=67108864
KAIROS_RECALL_SQL_MAX_SQLITE_VALUE_BYTES=16777216
# 每个 RunCoordinator 的召回子进程并发上限与单条 IPC 消息字节上限。
KAIROS_RECALL_SQL_MAX_CONCURRENT_PROCESSES=4
KAIROS_RECALL_SQL_MAX_IPC_BYTES=16777216

# web_fetch 始终可用，从 Server 执行 GET；超时覆盖 DNS、重定向和正文读取。
KAIROS_WEB_FETCH_TIMEOUT_MS=15000
KAIROS_WEB_FETCH_MAX_RESPONSE_BYTES=1048576
KAIROS_WEB_FETCH_MAX_TEXT_CHARACTERS=100000
KAIROS_WEB_FETCH_MAX_REDIRECTS=5
# web_search 需要显式选择一种外部索引。未配置 PROVIDER 时仅 web_search 返回未配置错误。
# SearXNG 使用完整搜索端点，不携带查询或片段；自托管实例可以使用 HTTP。
# KAIROS_WEB_SEARCH_PROVIDER=searxng
# KAIROS_WEB_SEARCH_SEARXNG_URL=http://127.0.0.1:8080/search
# Brave 使用 API key；默认端点为 https://api.search.brave.com/res/v1/web/search。
# KAIROS_WEB_SEARCH_PROVIDER=brave
# KAIROS_WEB_SEARCH_BRAVE_API_KEY=replace-with-brave-api-key
# 兼容代理需要覆盖端点时设置下一项；非环回地址必须使用 HTTPS。
# KAIROS_WEB_SEARCH_BRAVE_URL=https://search-proxy.example.com/res/v1/web/search
KAIROS_WEB_SEARCH_TIMEOUT_MS=10000
KAIROS_WEB_SEARCH_MAX_RESPONSE_BYTES=1048576
# 每个 RunCoordinator 按租户计算滚动 60 秒搜索额度，同一租户的主对话、任务 Thread 和 Subagent 共用。
KAIROS_WEB_SEARCH_MAX_REQUESTS_PER_MINUTE=30

# 平台默认模型接口。未配置 BASE_URL 和 MODEL_ID 时不能执行 Agent 任务。
# API 类型只区分协议格式，可选 openai_chat_completions、openai_responses、anthropic_messages；默认保持 Chat Completions。
# KAIROS_MODEL_API_TYPE=openai_chat_completions
# Chat Completions 与 Responses 的地址通常以 /v1 结尾，分别追加 /chat/completions、/responses。
# Anthropic 地址可填写 https://api.anthropic.com，系统追加 /v1/messages；密钥通过 x-api-key 发送。
# KAIROS_MODEL_BASE_URL=https://model-provider.example.com/v1
# KAIROS_MODEL_ID=replace-with-model-id
# 接口不要求认证时可省略。OpenAI 类型通过 Authorization: Bearer 发送。
# KAIROS_MODEL_API_KEY=replace-with-api-key
# KAIROS_MODEL_CONTEXT_WINDOW=128000
# KAIROS_MODEL_OUTPUT_RESERVE=4096
# KAIROS_MODEL_REQUEST_TIMEOUT_MS=120000
# 仅接受 true 或 false；false 表示模型不支持图片输入，图片会在 token 估算和发送前被拒绝。
# KAIROS_MODEL_SUPPORTS_VISION=true

# 受限 browser 工具使用 Playwright 驱动的完整 Chromium，无头模式不需要显示服务器。
# 浏览器二进制的安装与 k1 配置见 docs/development.md 和 docs/operations.md。
# 下载目录与 Server 运行时的解析目录必须一致；不设置时使用 Playwright 默认缓存目录。
# PLAYWRIGHT_BROWSERS_PATH=/absolute/path/to/ms-playwright
# 可选：直接使用兼容的完整 Chromium 绝对路径，覆盖 PLAYWRIGHT_BROWSERS_PATH 的默认解析。
# KAIROS_BROWSER_EXECUTABLE_PATH=/absolute/path/to/chromium

# 真实模型验收开关；默认测试不执行真实请求，scripts/real-model.sh 会设为 1。
# KAIROS_RUN_REAL_MODEL=1
# 真实验收配置路径，相对路径从仓库根目录解析。模型配置优先级：进程环境 > env-file > 测试默认。
# KAIROS_MODEL_ENV_FILE=.env
# 脱敏验收报告的输出路径，不包含凭据或完整模型正文。
# KAIROS_REAL_MODEL_REPORT=work/real-model-acceptance.json

# 以下变量需在 Daemon 进程环境中设置，不会从 Server 的 .env 自动传递。远程地址必须使用 wss://。
# KAIROS_DEVICE_SERVER_URL=ws://127.0.0.1:4317/devices/wss
# KAIROS_DEVICE_PAIRING_CREDENTIAL=replace-with-one-time-pairing-credential
# KAIROS_DEVICE_NAME=my-mac
# KAIROS_DEVICE_BASH_ENABLED=true
# KAIROS_DEVICE_IDENTITY_PATH=/absolute/path/to/kairos/daemon/identity.json

# 用户模型默认只允许公网 HTTPS。部署者可明确放行受控内网 Origin（准确协议、主机和端口）。
# KAIROS_MODEL_ALLOWED_ORIGINS=https://models.internal.example.com,http://127.0.0.1:8000
