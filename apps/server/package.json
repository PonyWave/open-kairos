{
  "name": "@kairos/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-fastify": "2.3.0",
    "@kairos/agent-core": "workspace:*",
    "@kairos/contracts": "workspace:*",
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "@mozilla/readability": "0.6.0",
    "fastify": "5.12.7",
    "ipaddr.js": "2.5.0",
    "linkedom": "0.18.12",
    "nodemailer": "10.3.1",
    "ws": "8.22.1",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
