{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!!reference",
      "!!.tower",
      "!!node_modules",
      "!!**/dist",
      "!!coverage",
      "!!data",
      "!!.pnpm-store",
      "!!work",
      "!!docs",
      "!!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
