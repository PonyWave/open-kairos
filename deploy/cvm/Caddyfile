{
	admin off
	default_sni 43.142.128.4
}

43.142.128.4 {
	tls force_automate {
		issuer acme {
			profile shortlived
		}
	}

	root * /opt/kairos/current/gui
	encode zstd gzip

	@api path /api /api/*
	handle @api {
		uri strip_prefix /api
		reverse_proxy 127.0.0.1:4317 {
			header_up Host {http.request.header.Host}
			header_up Origin {http.request.header.Origin}
			flush_interval -1
		}
	}

	@server path /devices/wss /health /daemon /daemon/*
	handle @server {
		reverse_proxy 127.0.0.1:4317 {
			header_up Host {http.request.header.Host}
			header_up Origin {http.request.header.Origin}
			flush_interval -1
		}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
