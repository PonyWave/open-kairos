[Unit]
Description=Kairos Caddy HTTPS entry
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=kairos-caddy
Group=kairos-caddy
Environment=HOME=/var/lib/kairos/caddy
Environment=XDG_DATA_HOME=/var/lib/kairos/caddy/data
Environment=XDG_CONFIG_HOME=/var/lib/kairos/caddy/config
ExecStart=/opt/kairos/runtime/caddy-2.10.2/caddy run --environ --config /etc/kairos/caddy/Caddyfile --adapter caddyfile
ExecReload=/opt/kairos/runtime/caddy-2.10.2/caddy reload --config /etc/kairos/caddy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kairos/caddy
LimitNOFILE=1048576
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
