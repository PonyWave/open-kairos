[Unit]
Description=Kairos Server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=kairos-server
Group=kairos-server
WorkingDirectory=/var/lib/kairos/server
EnvironmentFile=/etc/kairos/server.env
ExecStart=/opt/kairos/runtime/node-v26.4.0-linux-x64/bin/node /opt/kairos/current/app/apps/server/dist/main.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=40s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kairos/server
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
