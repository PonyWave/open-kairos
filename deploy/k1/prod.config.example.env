NODE_ENV=production
KAIROS_HOST=127.0.0.1
KAIROS_PORT=4317
KAIROS_CADDY_PORT=14317
KAIROS_CHAMBER_SERVICE=kairos
KAIROS_PUBLIC_ORIGIN=https://kairos.app.msh.team
KAIROS_DATA_DIR=/home/wanghailong/kairos/prod/data
KAIROS_DAEMON_RELEASE_DIR=/home/wanghailong/kairos/prod/daemon-releases
KAIROS_AUTH_SECRET=replace-with-at-least-32-character-random-secret
KAIROS_AUTH_INVITED_EMAILS=replace-with-invited-email@example.com
KAIROS_SMTP_URL=smtps://replace-user:replace-password@smtp.example.com:465
KAIROS_SMTP_FROM=replace-sender@example.com
KAIROS_MAX_ACTIVE_THREADS=2
KAIROS_MAX_CONCURRENT_MODEL_REQUESTS=4
